# Copia este archivo a .env y pega tu API key de z.ai (https://z.ai/model-api)
# El archivo .env está en .gitignore: la clave nunca se sube al repo.
ZAI_API_KEY=

# API de z.ai, compatible con OpenAI
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Modelos (ajústalos según los que tenga tu cuenta)
# Visión: glm-4.6v (recomendado), glm-4.5v
# Texto:  glm-5.3 (flagship), glm-4.6, glm-5.3-flash (más barato)
MODELO_VISION=glm-4.6v
MODELO_TEXTO=glm-5.3
